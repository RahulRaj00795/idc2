rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "Rahulraj2mar@gmail.com" ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/connection {
      allow read, write: if true;
    }

    // Diaspora Achievers
    match /achievers/{achieverId} {
      allow read, write: if true;
    }

    // Diaspora News
    match /news/{newsId} {
      allow read, write: if true;
    }

    // Project Showcases
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Blog Posts & Articles
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Diaspora Events
    match /events/{eventId} {
      allow read, write: if true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidContactSubmission(data) {
      return data.keys().hasAll([
          'id',
          'fullName',
          'email',
          'country',
          'subject',
          'message',
          'recipientEmail',
          'emailStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'fullName',
          'email',
          'country',
          'subject',
          'message',
          'recipientEmail',
          'emailStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 150 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.country is string && data.country.size() <= 100 &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 250 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 5000 &&
        data.recipientEmail is string && data.recipientEmail.size() >= 3 && data.recipientEmail.size() <= 200 &&
        data.emailStatus is string && data.emailStatus in ['sending', 'sent', 'pending_activation', 'failed'] &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 100 &&
        data.updatedAt is timestamp;
    }

    function isValidNriPio(data) {
      return data.keys().hasAll([
          'id',
          'name',
          'photoUrl',
          'country',
          'awarded',
          'designation',
          'details',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'photoUrl',
          'country',
          'awarded',
          'designation',
          'details',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.photoUrl is string && data.photoUrl.size() >= 1 && data.photoUrl.size() <= 800000 &&
        data.country is string && data.country.size() >= 1 && data.country.size() <= 120 &&
        data.awarded is string && data.awarded.size() >= 1 && data.awarded.size() <= 200 &&
        data.designation is string && data.designation.size() <= 200 &&
        data.details is string && data.details.size() >= 1 && data.details.size() <= 10000 &&
        data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 100 &&
        data.updatedAt is timestamp;
    }

    // Site Configuration (e.g. Home Banner)
    match /siteConfig/{configId} {
      allow read, write: if true;
    }

    // Contact Us Form Submissions
    match /contactSubmissions/{submissionId} {
      allow read, delete: if true;
      allow create, update: if isValidId(submissionId) &&
        isValidContactSubmission(request.resource.data) &&
        request.resource.data.id == submissionId;
    }

    // NRI / PIO Members
    match /nriPio/{memberId} {
      allow read, delete: if true;
      allow create, update: if isValidId(memberId) &&
        isValidNriPio(request.resource.data) &&
        request.resource.data.id == memberId;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }
  }
}

