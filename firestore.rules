rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "Rahulraj2mar@gmail.com" ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing
    match /test/connection {
      allow read, write: if true;
    }

    // Diaspora Achievers
    match /achievers/{achieverId} {
      allow read, write: if true;
    }

    // Diaspora News
    match /news/{newsId} {
      allow read, write: if true;
    }

    // Project Showcases
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Blog Posts & Articles
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Diaspora Events
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
